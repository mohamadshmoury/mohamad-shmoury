# Configure these with `supabase secrets set`; never expose them as VITE_* values.
GH_A_ADMIN_CODE=replace-with-a-long-private-admin-code
GH_A_ADMIN_TOKEN_SECRET=replace-with-at-least-32-random-characters
GH_A_ACCESS_SECRET=replace-with-at-least-32-random-characters
GH_A_ALLOWED_ORIGINS=https://your-deployed-site.example
